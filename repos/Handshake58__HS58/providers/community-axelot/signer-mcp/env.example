# Required. Use a dedicated low-value trading wallet, never a main coldkey.
TAO_COLDKEY_MNEMONIC="your twelve or twenty-four words"

# Bittensor endpoint. Use testnet/localnet before Finney.
SUBTENSOR_ENDPOINT=wss://test.finney.opentensor.ai:443
BITTENSOR_CHAIN=bittensor-testnet

# Local signer safety policy.
MAX_TAO_PER_TRADE=0.25
MAX_TAO_PER_DAY=1
MAX_TRADES_PER_DAY=25
MAX_OPEN_EXPOSURE_TAO=2
MAX_SLIPPAGE_PCT=1.5
MIN_SECONDS_BETWEEN_TRADES=0
REQUIRE_CONFIRM=true
ALLOW_RESTORE_UNPROTECTED=false
ALLOW_RECYCLE_ALPHA=false
ALLOWED_PROVIDERS=community-axelot
ALLOWED_ACTIONS=stake,unstake,full_unstake,move,swap,recycle

# Optional comma-separated netuid allowlist, empty means all.
ALLOWED_NETUIDS=

# Small bounded state file for autonomous agents. This is not an append-only log.
TRADE_STATE_PATH=./data/trade-state.json
TRADE_STATE_ACTIVE_LIMIT=20
TRADE_STATE_RECENT_LIMIT=30

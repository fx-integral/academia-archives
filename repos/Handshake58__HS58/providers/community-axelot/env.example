# === REQUIRED ===
PROVIDER_PRIVATE_KEY=0xYOUR_POLYGON_PROVIDER_PRIVATE_KEY

# === DRAIN / BLOCKCHAIN ===
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
CHAIN_ID=137
CLAIM_THRESHOLD=1000000
AUTO_CLAIM_INTERVAL_MINUTES=10
AUTO_CLAIM_BUFFER_SECONDS=3600
STORAGE_PATH=./data/vouchers.json

# === BITTENSOR ===
SUBTENSOR_ENDPOINT=wss://entrypoint-finney.opentensor.ai:443
BITTENSOR_CHAIN=bittensor-finney
MARKET_CACHE_TTL_MS=15000
MAX_SUBNET_SCAN=256

# === SERVER ===
PORT=3000
HOST=0.0.0.0
PROVIDER_NAME=Community-Axelot

# === RATE LIMITING ===
READ_RATE_LIMIT_PER_MINUTE=30
PLAN_RATE_LIMIT_PER_MINUTE=10

# === OPTIONAL ===
ADMIN_PASSWORD=

# Orchestrator-only env (copy to `neurons/orchestrator/.env` or set from shell)
#
# BeamCore V2:
#   SUBNET_CORE_URL  → core-server HTTP (registration, REST)
#   ORCH_GATEWAY_URL → orch-gateway WebSocket edge (required at runtime)
#   REGISTRY_URL     → defaults to SUBNET_CORE_URL if unset
#   WORKER_GATEWAY_PUBLIC_URL → optional; your own worker-gateway URL registered with BeamCore

# =============================================================================
# NETWORK (choose testnet OR mainnet block)
# =============================================================================

# --- Testnet (Subnet 304) ---
SUBNET_CORE_URL=https://beamcore-dev.b1m.ai
ORCH_GATEWAY_URL=https://orch-gateway-dev.b1m.ai
SUBTENSOR_NETWORK=test
NETUID=304

# --- Mainnet (Subnet 105) — comment testnet lines above ---
# SUBNET_CORE_URL=https://beamcore.b1m.ai
# ORCH_GATEWAY_URL=https://orch-gateway.b1m.ai
# SUBTENSOR_NETWORK=finney
# NETUID=105

# REGISTRY_URL=https://beamcore-dev.b1m.ai
# WORKER_GATEWAY_PUBLIC_URL=https://your-worker-gateway.example
# READY=false

# =============================================================================
# WALLET / PROCESS
# =============================================================================
WALLET_NAME=orchestrator
WALLET_HOTKEY=default
WALLET_PATH=~/.bittensor/wallets

API_PORT=8000
LOG_LEVEL=INFO
LOCAL_MODE=false

# =============================================================================
# FEES / WORKERS / TASKS
# =============================================================================
FEE_PERCENTAGE=0.0
MAX_WORKERS=10000
WORKER_TIMEOUT=300
MIN_WORKER_BANDWIDTH=10.0
WORKER_HEARTBEAT_INTERVAL=30
MAX_CONCURRENT_TASKS=1000
TASK_TIMEOUT=120

# =============================================================================
# OPTIONAL PERSISTENCE
# =============================================================================
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/beam
# REDIS_URL=redis://localhost:6379

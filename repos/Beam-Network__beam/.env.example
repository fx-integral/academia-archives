# Beam node environment (orchestrator, worker, validator)
# Copy to `.env` and adjust. Never commit `.env`.
#
# --- BeamCore V2 mapping (see github.com/Beam-Network/beamcore_v2 README) ---
# SUBNET_CORE_URL / BEAM_*_SUBNET_CORE_URL → core-server public HTTP (:8000 in a local deploy)
# ORCH_GATEWAY_URL                             → orch-gateway WebSocket edge (:8002 locally)
# BUFFER_URL                                   → worker-gateway HTTP/WS origin (:8001 locally) — NOT core-server
# Optional METAGRAPH_SYNC_URL                  → metagraph-sync HTTP sidecar (:8090 locally); only needed if tooling/docs refer to it
#
# Paths are mounted at the API root (no /api prefix). Workers post payment/PoB evidence to core-server HTTP.

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================
# Use ONE block (testnet OR mainnet) for SUBNET/ORCH/BUFFER.*

# -----------------------------------------------------------------------------
# TESTNET — Subnet 304
# -----------------------------------------------------------------------------
# core-server (HTTP API + registration)
SUBNET_CORE_URL=https://beamcore-dev.b1m.ai
# orch-gateway (orchestrator control-plane WebSocket; relays to core-server)
ORCH_GATEWAY_URL=https://orch-gateway-dev.b1m.ai
# worker-gateway: WebSocket edge for chunk offers (`BUFFER_*` naming is historical).
# Use the origin your BeamCore deployment exposes for worker-gateway (often :8001 in self-hosted stacks).
BUFFER_URL=http://api.beamcore-dev.b1m.ai:8081
# If you operate your own worker-gateway, advertise it here (BeamCore registration); optional.
# WORKER_GATEWAY_PUBLIC_URL=https://your-worker-gateway.example

SUBTENSOR_NETWORK=test
NETUID=304

BEAM_NETUID=304
BEAM_SUBTENSOR_NETWORK=test

# -----------------------------------------------------------------------------
# MAINNET — Subnet 105 (comment TESTNET vars above before using)
# -----------------------------------------------------------------------------
# SUBNET_CORE_URL=https://beamcore.b1m.ai
# ORCH_GATEWAY_URL=https://orch-gateway.b1m.ai
# BUFFER_URL=http://api.beamcore.b1m.ai:8081
# WORKER_GATEWAY_PUBLIC_URL=https://your-orchestrator-worker-gateway.example
# SUBTENSOR_NETWORK=finney
# NETUID=105
# BEAM_NETUID=105
# BEAM_SUBTENSOR_NETWORK=finney

# Optional: validator UID bootstrap reaches core-server; alternate name read early in startup
# BEAM_SUBNET_CORE_URL=https://beamcore-dev.b1m.ai
# Optional: local/full-stack debugging only
# METAGRAPH_SYNC_URL=http://localhost:8090

# =============================================================================
# LOCAL DEVELOPMENT MODE
# =============================================================================
# LOCAL_MODE=true

# =============================================================================
# ORCHESTRATOR (unprefixed env vars)
# =============================================================================
#
# Quick start (repository root → neurons/orchestrator):
#   cd neurons/orchestrator && \
#   WALLET_NAME=your_coldkey WALLET_HOTKEY=your_hotkey \
#   SUBTENSOR_NETWORK=test NETUID=304 \
#   SUBNET_CORE_URL=https://beamcore-dev.b1m.ai \
#   ORCH_GATEWAY_URL=https://orch-gateway-dev.b1m.ai \
#   python main.py
#
# READY=true — after you are registered and healthy, opt in so routing can assign transfers (see BeamCore docs).

WALLET_NAME=orchestrator
WALLET_HOTKEY=default
# WALLET_PATH=~/.bittensor/wallets
# READY=false

# ORCHESTRATOR_HOST=0.0.0.0
# API_PORT=8000

# Defaults to SUBNET_CORE_URL when unset (worker discovery / registry HTTP)
# REGISTRY_URL=https://beamcore-dev.b1m.ai

# MAX_WORKERS=10000
# WORKER_TIMEOUT=300
# MIN_WORKER_BANDWIDTH=10.0
# FEE_PERCENTAGE=5.0

# =============================================================================
# VALIDATOR (BEAM_VALIDATOR_* prefix)
# =============================================================================
#
# Quick start:
#   cd neurons/validator && \
#   BEAM_VALIDATOR_WALLET_NAME=your_coldkey \
#   BEAM_VALIDATOR_WALLET_HOTKEY=your_hotkey \
#   BEAM_VALIDATOR_SUBNET_CORE_URL=https://beamcore-dev.b1m.ai \
#   python main.py

BEAM_VALIDATOR_WALLET_NAME=validator
BEAM_VALIDATOR_WALLET_HOTKEY=default
# BEAM_VALIDATOR_WALLET_PATH=~/.bittensor/wallets

BEAM_VALIDATOR_SUBNET_CORE_URL=https://beamcore-dev.b1m.ai
# BEAM_VALIDATOR_SUBNET_CORE_URL=https://beamcore.b1m.ai

# BEAM_VALIDATOR_PORT=8093
# BEAM_VALIDATOR_TASK_INTERVAL_SECONDS=12
# BEAM_VALIDATOR_TASKS_PER_EPOCH=10
# BEAM_VALIDATOR_CHUNK_SIZE_BYTES=10485760
# BEAM_VALIDATOR_BLOCKS_BETWEEN_WEIGHTS=100
# BEAM_VALIDATOR_WEIGHT_ALPHA=0.3
# BEAM_VALIDATOR_MIN_CONNECTION_STAKE=10.0
# BEAM_VALIDATOR_LOG_LEVEL=INFO
# BEAM_VALIDATOR_DEBUG=false

# =============================================================================
# DATABASE / REDIS (optional — local orchestrator persistence only)
# =============================================================================
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/beam
# REDIS_URL=redis://localhost:6379
